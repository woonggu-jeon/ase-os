# API server port (NestJS)
PORT=3001

# Base URL the browser uses to reach the API directly (uploads bypass the Next
# dev proxy's 10 MB body limit). Must be exposed to the client (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_API_BASE=http://localhost:3001

# Whisper.cpp model for local transcription (see ADR 0003).
# tiny (fastest) | base (default) | small ... — larger = more accurate, still free/local.
WHISPER_MODEL=base

# Transcription language hint: auto (detect) or a code like en, ko.
WHISPER_LANGUAGE=auto

# FFmpeg scene-change threshold (0..1). Higher = fewer cuts. Default 0.4.
SCENE_THRESHOLD=0.4

# OPENAI_API_KEY is currently unused (project runs free/local per ADR 0002).
# Kept only for a possible future OpenAI provider if the free-only rule changes.
# OPENAI_API_KEY=
